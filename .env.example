# URL base da API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Porta em que o front (Next) sobe no `pnpm dev`
PORT=3001

# Imagens de fallback dos cards de animal (opcionais).
# Default: cataas.com (gato) e placedog.net (cão).
# NEXT_PUBLIC_FALLBACK_CAT_IMAGE_URL=https://cataas.com/cat?width=500&height=500
# NEXT_PUBLIC_FALLBACK_DOG_IMAGE_URL=https://placedog.net/500/500
