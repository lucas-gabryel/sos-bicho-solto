generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROTETOR
}

enum AnimalSpecies {
  CACHORRO
  GATO
  OUTRO
}

enum AnimalSex {
  MACHO
  FEMEA
}

enum AnimalSize {
  PEQUENO
  MEDIO
  GRANDE
}

enum AnimalStatus {
  EM_ACOLHIMENTO
  ADOTADO
  EM_TRATAMENTO
  FALECIDO
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Animal {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  species     AnimalSpecies
  breed       String        @db.VarChar(120)
  sex         AnimalSex
  age         Int
  weight      Decimal?      @db.Decimal(5, 2)
  size        AnimalSize
  status      AnimalStatus  @default(EM_ACOLHIMENTO)
  color       String?       @db.VarChar(80)
  description String?       @db.Text
  photoUrl    String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  adoptions   Adoption[]

  @@index([name])
  @@index([species, status])
  @@map("animals")
}

model Tutor {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(120)
  cpf       String     @unique @db.VarChar(11)
  phone     String     @db.VarChar(20)
  email     String?    @unique @db.VarChar(255)
  address   String     @db.VarChar(255)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  adoptions Adoption[]

  @@index([name])
  @@index([cpf])
  @@map("tutors")
}

model Adoption {
  id           String   @id @default(uuid()) @db.Uuid
  animalId     String   @db.Uuid
  tutorId      String   @db.Uuid
  adoptionDate DateTime
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  animal       Animal   @relation(fields: [animalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tutor        Tutor    @relation(fields: [tutorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([animalId])
  @@index([tutorId])
  @@index([adoptionDate])
  @@map("adoptions")
}
